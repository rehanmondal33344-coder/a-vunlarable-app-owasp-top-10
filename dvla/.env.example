# Environment Configuration for DVLA
# Copy this file to .env and fill in your values

# =============================================================
# LLM Provider Configuration
# =============================================================
# Options: ollama, openai, anthropic, gemini, mock
LLM_PROVIDER=ollama

# Ollama settings (default, runs locally — no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI settings (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic settings (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Gemini settings (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# =============================================================
# Server Configuration
# =============================================================
PORT=3000
HOST=localhost

# =============================================================
# Security Settings
# =============================================================
# Rate limit: max requests per window (hardened mode only)
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000

# Max tokens per LLM response (hardened mode only)
MAX_RESPONSE_TOKENS=4096

# Max tool call recursion depth (hardened mode only)
MAX_TOOL_RECURSION=3
